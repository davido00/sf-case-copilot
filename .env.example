# Copy this file to `.env` and fill in real values:
#     cp .env.example .env
# `.env` is gitignored — your real keys never get committed.
# Keep this template file around; it documents which vars the project needs.

# --- Step 1: Anthropic ---
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# --- Step 6: where Cases and Articles come from ---
# mock       = read data/sample_cases.json (default, free, works offline)
# salesforce = query the org configured below
DATA_SOURCE=mock

# --- Step 6: Salesforce auth, option A — access token (PREFERRED) ---
# Plain OAuth. No SOAP, no security token. Newly created orgs disable the SOAP
# login() endpoint by default, and Salesforce retires it in Summer '27, so this
# is the path that keeps working. Get both values from the Salesforce CLI:
#     sf org login web --alias play
#     sf org display --target-org play --json
# then copy "accessToken" and "instanceUrl" from the output.
# Note: access tokens expire — re-run the display command to refresh.
# SF_ACCESS_TOKEN=00D...!AQ...
# SF_INSTANCE_URL=https://your-org.my.salesforce.com

# --- Step 6: Salesforce auth, option B — username/password (LEGACY) ---
# Only used when SF_ACCESS_TOKEN is not set. Requires SOAP login() to be enabled:
#     Setup > Quick Find "User Interface" > Enable SOAP API login()   (one-way!)
# SF_SECURITY_TOKEN is NOT your password — reset it at
# Setup > My Personal Information > Reset My Security Token, and it arrives by email.
SF_USERNAME=you@example.com.dev
SF_PASSWORD=your-password
SF_SECURITY_TOKEN=token-emailed-by-salesforce

# "login" for Developer / Trailhead / production orgs. "test" for sandboxes.
SF_DOMAIN=login

# Which custom rich-text field on Knowledge__kav holds the article body.
# Salesforce does not ship one — you create it yourself, so the name varies
# between orgs. Change this if you called yours something else.
SF_KNOWLEDGE_BODY_FIELD=Answer__c

# --- In-org build: the service ---
# Shared secret Salesforce sends as the X-Copilot-Secret header. The service
# refuses to start without it. Generate one with:
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
COPILOT_SHARED_SECRET=generate-your-own
